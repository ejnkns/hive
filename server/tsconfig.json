{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "noEmit": true,
    "paths": {
      "workflow-engine": ["../workflow-engine/src"],
      "workflow-engine/*": ["../workflow-engine/src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "../presets/queen-bee/**/*.ts",
    "../presets/wayfinder/**/*.ts"
  ]
}
